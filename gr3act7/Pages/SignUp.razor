@page "/signup"
@inject AuthService Auth
@inject NavigationManager Nav

<h3>Sign Up</h3>
<div class="mb-3">
    <input class="form-control mb-1" placeholder="Username" @bind="username" />
    <input class="form-control mb-1" placeholder="Password" type="password" @bind="password" />
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="text-danger">@error</div>
    }
    <button class="btn btn-success" @onclick="SignUpUser">Sign Up</button>
</div>
<p>
    Already have an account? <a href="/login">Login</a>
</p>

@code {
    private string username = "";
    private string password = "";
    private string error = "";

    private void SignUpUser()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Username and password are required.";
            return;
        }
        if (!Auth.Register(username, password))
        {
            error = "Username already exists.";
            return;
        }
        Nav.NavigateTo("/login");
    }
}