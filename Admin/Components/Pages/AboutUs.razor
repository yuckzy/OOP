@code {
    private bool IsActive(string href)
    {
        var uri = NavigationManager.Uri.Replace(NavigationManager.BaseUri, "/");
        return uri.StartsWith(href, StringComparison.OrdinalIgnoreCase);
    }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
/* LAYOUT STYLES */
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.dashboard-layout {
    display: flex;
    width: 100vw;
    height: 100vh;
    font-family: 'Poppins', sans-serif;
    position: fixed;
    top: 0;
    left: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.sidebar {
    width: 250px;
    background: linear-gradient(180deg, #063970 0%, #01254e 100%);
    color: white;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 4px 0 15px rgba(0, 0, 0, 0.3);
    z-index: 10;
    height: 100vh;
    overflow-y: auto;
}

.logo-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2rem;
    text-align: center;
}

.logo-image {
    width: 120px;
    height: 120px;
    object-fit: contain;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    padding: 8px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    margin-bottom: 1rem;
    transition: transform 0.3s ease;
}

.logo-image:hover {
    transform: scale(1.05);
}

.system-name {
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    color: #e0f1ff;
    letter-spacing: 0.5px;
    line-height: 1.4;
}

nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    color: #e0f1ff;
    font-weight: 500;
    padding: 0.8rem 1rem;
    border-radius: 10px;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.05);
}

.nav-link:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    transform: translateX(6px);
}

.nav-link.active {
    background: linear-gradient(90deg, #0056b3, #007bff);
    color: #fff;
    box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4);
    transform: translateX(6px);
}

.nav-link i {
    font-size: 1.2rem;
}

.logout-container {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding-top: 2rem;
}

.logout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    background: rgba(255, 255, 255, 0.1);
    color: #e0f1ff;
    border: none;
    font-weight: 500;
    padding: 0.8rem 1.5rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.3s ease;
    width: 100%;
    max-width: 180px;
    font-size: 1rem;
    font-family: 'Poppins', sans-serif;
}

.logout-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.logout-btn i {
    font-size: 1.1rem;
}

.main-content {
    flex: 1;
    position: relative;
    overflow-y: auto;
    display: flex;
    margin: 0;
    padding: 0;
    width: calc(100vw - 250px);
    height: 100vh;
    background: white;
}

.background-overlay {
    background-image: url('https://learnandsupport.getolympus.com/sites/default/files/styles/hero_large/public/2020-10/amico_-_water_droplets_1.jpg?itok=kJ972xkJ');
    background-size: cover;
    background-position: center;
    filter: blur(3px) brightness(0.95);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.page-container {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    overflow-y: auto;
    color: #fff;
}

::-webkit-scrollbar {
    width: 8px;
}
::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.4);
    border-radius: 4px;
}

* {
    box-sizing: border-box;
}

/* ABOUT US SPECIFIC STYLES */
.about-container {
